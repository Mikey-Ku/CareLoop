{
  "name": "@mhacks2026/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "packet": "node --env-file-if-exists=../../.env src/cli/packet.ts",
    "simulate": "node --env-file-if-exists=../../.env src/cli/simulate.ts",
    "agent": "node --env-file-if-exists=../../.env src/agent.ts",
    "relay:check": "node --env-file-if-exists=../../.env src/cli/relay-check.ts",
    "llm:check": "node --env-file-if-exists=../../.env src/cli/llm-check.ts",
    "content:eval": "node --env-file-if-exists=../../.env src/cli/content-eval.ts",
    "vitals:video": "node --env-file-if-exists=../../.env src/cli/vitals-video.ts",
    "record-fixtures": "node --env-file-if-exists=../../.env ../../scripts/record-fixtures.ts"
  },
  "dependencies": {
    "@relaymessenger/elevenlabs": "0.1.1",
    "@relaymessenger/sdk": "0.5.1",
    "@smartspectra/node-sdk": "3.4.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "node-webcodecs": "1.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
