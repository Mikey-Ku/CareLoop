# Copy to .env and fill in. Never commit .env.

# FinchNode (demo API needs no key; sandbox keys start with ck_test_)
FINCHNODE_BASE_URL=https://api.finchnode.com/demo/v1
FINCHNODE_API_KEY=

# Relay Messenger
RELAY_API_URL=https://api.relayapp.im
RELAY_AGENT_TOKEN=
RELAY_WEBHOOK_SECRET=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Anthropic
ANTHROPIC_API_KEY=

# Presage SmartSpectra
PRESAGE_API_KEY=

# App
PORT=3000
DATABASE_PATH=./data/app.db
CHECKIN_TIME=09:00
MISSED_CHECKIN_TIME=12:00
