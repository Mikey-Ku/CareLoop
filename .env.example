# Copy to .env and fill in. Never commit .env.

# FinchNode (demo API needs no key; sandbox keys start with ck_test_)
FINCHNODE_BASE_URL=https://api.finchnode.com/demo/v1
FINCHNODE_API_KEY=

# Relay Messenger
RELAY_API_URL=https://api.relayapp.im
RELAY_AGENT_TOKEN=
# Delivery is WebSocket, so no webhook secret is needed.
# The senior's Relay handle and the family members' handles (comma separated).
PATIENT_RELAY_HANDLE=
FAMILY_RELAY_HANDLES=
# Which FinchNode subject the senior is (demo: patient-demo-polypharmacy)
PATIENT_FINCHNODE_SUBJECT=patient-demo-polypharmacy
PATIENT_TIMEZONE=America/Detroit

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# LLM for understanding free-text replies and reading paper photos.
# gemini (default, free tier: synthetic data only) or anthropic.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Models tried in order; a busy one (503, 429, slow) is skipped at once; then buttons.
GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_TIMEOUT_MS=12000
LLM_ATTEMPT_TIMEOUT_MS=4000

# Anthropic (only when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Presage SmartSpectra
PRESAGE_API_KEY=

# App
PORT=3000
DATABASE_PATH=./data/app.db
CHECKIN_TIME=09:00
MISSED_CHECKIN_TIME=12:00
# Demo clock: the check-in date rules reason about (YYYY-MM-DD). Empty = the snapshot's dataAsOf. Leave empty in production.
CLOCK_DATE=
